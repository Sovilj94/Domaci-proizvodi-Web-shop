# Kopiraj u .env.local (lokalno) ili unesi u Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* vrijednosti se ugrađuju u build: nakon izmjene na Vercelu treba Redeploy.

# URL ASP.NET API-ja, bez kose crte na kraju.
#   lokalno: http://localhost:5080
#   Render:  https://epiljara-api.onrender.com
# PRAZNO = frontend koristi ugrađeni mock (/api) umjesto pravog backenda.
NEXT_PUBLIC_API_URL=

# Opciono — samo ako je uključena prijava preko Google-a / Facebook-a.
# Google client id mora biti isti kao Auth__Google__ClientId na backendu.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
