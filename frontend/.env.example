# Kopiraj u .env.local (lokalno) ili unesi u Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* vrijednosti se ugrađuju u build: nakon izmjene na Vercelu treba Redeploy.

# URL ASP.NET API-ja, bez kose crte na kraju.
#   lokalno: http://localhost:5080
#   Render:  https://epiljara-api.onrender.com
# PRAZNO = http://localhost:5080. Ugrađenih (mock) podataka nema — sve dolazi sa API-ja.
NEXT_PUBLIC_API_URL=

# Opciono — samo ako je uključena prijava preko Google-a / Facebook-a.
# Google client id mora biti isti kao Auth__Google__ClientId na backendu.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# --- SEO (lib/seo/site.ts) ---
# Javna adresa sajta: kanonski URL-ovi, sitemap.xml, Open Graph. Bez nje na Vercelu se
# uzima produkcijski *.vercel.app domen, a lokalno http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# "true" tek na pravom domenu. Bez toga robots.txt zabranjuje sve i svaka stranica nosi
# noindex — test deploy sa demo podacima ne smije u Google.
SEO_INDEX=
# Opciono: kod iz Google Search Console (Settings → Ownership → HTML tag, samo content="…").
GOOGLE_SITE_VERIFICATION=
