<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EPiljara.Application\EPiljara.Application.csproj" />
    <ProjectReference Include="..\EPiljara.Domain\EPiljara.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Relational mora biti eksplicitan i NE PrivateAssets. Inače ga u runtime dovlači
      samo Npgsql.EntityFrameworkCore.PostgreSQL (9.0.1), dok se ovaj projekat
      kompajlira prema 9.0.11 koji dolazi kroz EntityFrameworkCore.Design — a Design je
      PrivateAssets=all, pa do API-ja ne stiže. Zbog toga je svaki poziv iz Relational
      (npr. ToTable) prolazio build i padao na startu sa FileNotFoundException, uz
      MSB3277 warning kao jedini nagovještaj. Držati u istoj verziji kao
      Microsoft.EntityFrameworkCore.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
